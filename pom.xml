<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>ch.admin.bit.jeap</groupId>
        <artifactId>jeap-spring-boot-parent</artifactId>
        <version>41.35.0</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>

    <groupId>ch.admin.bit.jeap.jme.reactionobserver</groupId>
    <artifactId>jme-reaction-observer-service-example</artifactId>
    <version>13.26.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>JME Reaction Observer Service Example</name>
    <description>
        JME example instance of the jEAP Reaction Observer Service
    </description>

    <url>https://github.com/jme-admin-ch/jme-reaction-observer-service-example/tree/main</url>
    <scm>
        <url>https://github.com/jme-admin-ch/jme-reaction-observer-service-example.git</url>
        <connection>scm:git:git://github.com/jme-admin-ch/jme-reaction-observer-service-example.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/jme-admin-ch/jme-reaction-observer-service-example.git</developerConnection>
    </scm>
    <developers>
        <developer>
            <name>BIT</name>
            <email>jeap-community@bit.admin.ch</email>
            <organization>Federal Office of Information Technology, Systems and Telecommunication FOITT</organization>
            <organizationUrl>https://www.bit.admin.ch/</organizationUrl>
        </developer>
    </developers>
    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0</url>
        </license>
    </licenses>

    <properties>
        <jme-spring-boot-integration-test.version>8.8.0</jme-spring-boot-integration-test.version>
        <jeap-oauth-mock-server.version>11.16.0</jeap-oauth-mock-server.version>
        <maven.javadoc.skip>false</maven.javadoc.skip>
        <!-- Version of the JmeRos* message types of the demo system in the jme-message-type-registry -->
        <jme-ros-message-types.version>1.0.0</jme-ros-message-types.version>
    </properties>

    <modules>
        <module>jme-reaction-observer-auth-scs</module>
        <module>jme-reaction-observer-service</module>
        <module>jme-ros-order-service</module>
        <module>jme-ros-partner-service</module>
        <module>jme-ros-header-only</module>
        <module>jme-ros-no-messaging</module>
        <module>jme-ros-external</module>
        <module>jme-reaction-observer-test</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>ch.admin.bit.jeap.jme.messagetype.jme</groupId>
                <artifactId>jme-ros-order-submitted-event</artifactId>
                <version>${jme-ros-message-types.version}</version>
            </dependency>
            <dependency>
                <groupId>ch.admin.bit.jeap.jme.messagetype.jme</groupId>
                <artifactId>jme-ros-order-checked-event</artifactId>
                <version>${jme-ros-message-types.version}</version>
            </dependency>
            <dependency>
                <groupId>ch.admin.bit.jeap.jme.messagetype.jme</groupId>
                <artifactId>jme-ros-credit-reserved-event</artifactId>
                <version>${jme-ros-message-types.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <!-- Add license to jar manifest -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <configuration>
                        <archive>
                            <manifestEntries>
                                <Bundle-License>https://www.apache.org/licenses/LICENSE-2.0</Bundle-License>
                            </manifestEntries>
                        </archive>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <!-- Check third-party license compliance -->
            <plugin>
                <groupId>org.honton.chas</groupId>
                <artifactId>license-maven-plugin</artifactId>
            </plugin>
            <!-- Generate third-party license list and check for missing license information -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>license-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
